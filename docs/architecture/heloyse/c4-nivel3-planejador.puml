@startuml
title C4 Nivel 3 - Componentes do Planejador de Rotas (Replanejamento)

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam rectangle {
    BackgroundColor<<componente>> #85BBF0
    BackgroundColor<<container>> #1168BD
    FontColor<<container>> #FFFFFF
    BackgroundColor<<externo>> #999999
    FontColor<<externo>> #FFFFFF
}

rectangle "API de Tráfego\n[Sistema externo]" as trafego <<externo>>
rectangle "API de Orquestração\n[Container: Node.js + NestJS]\nImplementa IReplanejamentoService" as api <<container>>

rectangle "Planejador de Rotas\n[Container: Python + gRPC]" {
    rectangle "RotaService\n[Componente: servidor gRPC]\nImplementa IPlanejadorRotas" as grpc <<componente>>
    rectangle "Replanejador\n[Componente]\nRegra do atraso <= 15 min" as replan <<componente>>
    rectangle "MapaDoParque\n[Componente: NetworkX]\nGrafo dos corredores" as grafo <<componente>>
    rectangle "CalculadorDeCaminho\n[Componente: algoritmo A*]" as astar <<componente>>
    rectangle "ClienteTrafego\n[Componente: requests]" as cliente <<componente>>
}

database "Banco de Dados\n[Container: PostgreSQL]" as bd
rectangle "API de Geolocalização\n[Sistema externo]" as geo <<externo>>

trafego --> api : informarBloqueio(BloqueioDTO)\n[HTTPS webhook]
api --> grpc : recalcularRota(RecalculoDTO)\n[gRPC, prazo 2s]
grpc --> replan : Delega
replan --> cliente : Condições do trecho
replan --> astar : Caminho alternativo
astar --> grafo : Percorre
replan --> geo : Dados de trajeto\n[HTTPS / REST]
cliente --> trafego : Consulta condições\n[HTTPS / REST]
grafo --> bd : Carrega corredores\n[SQL]

@enduml
